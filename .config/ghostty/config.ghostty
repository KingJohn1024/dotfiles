# Color theme (list all with: ghostty +list-themes)
theme = iTerm2 Solarized Dark

# Window transparency: 1.0 = opaque, lower = more transparent
background-opacity = 0.90

# Blur what's behind the window (true, false, or a radius like 20)
background-blur = true

# Font (Ghostty bundles JetBrains Mono by default; set this if you prefer another)
font-family = JetBrains Mono
font-size = 14

# Make Option work as Alt/Meta (zsh word-jumping with Opt+←/→, Alt bindings in vim)
macos-option-as-alt = true

# Breathing room around text
window-padding-x = 8
window-padding-y = 6

# Reopen windows and tabs where you left off
window-save-state = always

# Drop-down terminal from anywhere with Cmd+`
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Small quality-of-life settings
mouse-hide-while-typing = true
copy-on-select = clipboard
